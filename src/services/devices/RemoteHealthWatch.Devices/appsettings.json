{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": { "DevicesDb": "", "Redis": "" },
  "Jwt": { "Issuer": "remote-health-watch-identity", "Audience": "remote-health-watch", "SigningKey": "" },
  "Kafka": { "BootstrapServers": "localhost:9092" },
  "Services": { "PatientsHttp": "http://localhost:5102/", "PatientsGrpc": "http://localhost:5112" },
  "Ingestion": { "RateLimit": { "TokenLimit": 20, "TokensPerPeriod": 5, "PeriodSeconds": 5 } }
}
