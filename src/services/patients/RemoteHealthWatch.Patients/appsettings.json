{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Grpc": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Ports": { "Http": 8080, "Grpc": 8081 },
  "ConnectionStrings": { "PatientsDb": "" },
  "Jwt": { "Issuer": "remote-health-watch-identity", "Audience": "remote-health-watch", "SigningKey": "" },
  "Kafka": { "BootstrapServers": "localhost:9092" },
  "Enrollment": { "BaselineHours": 24 }
}
