{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Warning",
        "Quartz": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AlertsDb": "",
    "Redis": ""
  },
  "Jwt": {
    "Issuer": "remote-health-watch-identity",
    "Audience": "remote-health-watch",
    "SigningKey": ""
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  "Services": {
    "PatientsGrpc": "http://localhost:5112",
    "IdentityHttp": "http://localhost:5101/"
  },
  "Notifications": {
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "From": "alerts@remotehealthwatch.local",
    "DashboardUrl": "http://localhost:4200",
    "DigestCron": "0 0 7 * * ?"
  },
  "Database": {
    "MigrateOnStartup": true
  }
}
