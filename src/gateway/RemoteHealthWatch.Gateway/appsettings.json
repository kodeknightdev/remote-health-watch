{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "remote-health-watch-identity",
    "Audience": "remote-health-watch",
    "SigningKey": ""
  },
  "Cors": {
    "Origins": [
      "http://localhost:4200"
    ]
  },
  "RateLimits": {
    "Device": {
      "TokenLimit": 30,
      "TokensPerPeriod": 6,
      "PeriodSeconds": 5
    },
    "User": {
      "PermitLimit": 600
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/{**rest}"
        },
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "per-user"
      },
      "users": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/users/{**rest}"
        },
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-user"
      },
      "audit": {
        "ClusterId": "patients",
        "Match": {
          "Path": "/api/audit/{**rest}"
        },
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-user"
      },
      "patients": {
        "ClusterId": "patients",
        "Match": {
          "Path": "/api/patients/{**rest}"
        },
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-user",
        "Order": 100
      },
      "ingest": {
        "ClusterId": "devices",
        "Match": {
          "Path": "/api/ingest/{**rest}"
        },
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "per-device"
      },
      "devices": {
        "ClusterId": "devices",
        "Match": {
          "Path": "/api/devices/{**rest}"
        },
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-user"
      },
      "vitals": {
        "ClusterId": "vitals",
        "Match": {
          "Path": "/api/vitals/{**rest}"
        },
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-user"
      },
      "alerts": {
        "ClusterId": "alerts",
        "Match": {
          "Path": "/api/alerts/{**rest}"
        },
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-user"
      },
      "risk": {
        "ClusterId": "risk",
        "Match": {
          "Path": "/api/risk/{**rest}"
        },
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-user"
      },
      "insights": {
        "ClusterId": "insights",
        "Match": {
          "Path": "/api/insights/{**rest}"
        },
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-user"
      },
      "hubs": {
        "ClusterId": "realtime",
        "Match": {
          "Path": "/hubs/{**rest}"
        },
        "AuthorizationPolicy": "default"
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "d1": {
            "Address": "http://identity:8080/"
          }
        }
      },
      "patients": {
        "Destinations": {
          "d1": {
            "Address": "http://patients:8080/"
          }
        }
      },
      "devices": {
        "Destinations": {
          "d1": {
            "Address": "http://devices:8080/"
          }
        }
      },
      "vitals": {
        "Destinations": {
          "d1": {
            "Address": "http://vitals:8080/"
          }
        }
      },
      "alerts": {
        "Destinations": {
          "d1": {
            "Address": "http://alerts:8080/"
          }
        }
      },
      "realtime": {
        "Destinations": {
          "d1": {
            "Address": "http://realtime:8080/"
          }
        },
        "SessionAffinity": {
          "Enabled": true,
          "Policy": "Cookie",
          "AffinityKeyName": ".rhw.realtime"
        }
      },
      "risk": {
        "Destinations": {
          "d1": {
            "Address": "http://risk-engine:8000/"
          }
        }
      },
      "insights": {
        "Destinations": {
          "d1": {
            "Address": "http://insights:8000/"
          }
        }
      }
    }
  }
}