# Local development only. Copy to .env and adjust; .env is git-ignored.
# Every value here is a placeholder for the demo stack, not a real credential.

# SQL Server (one container, separate database + login per service)
MSSQL_SA_PASSWORD=Local_sa_Passw0rd!
IDENTITY_DB_PASSWORD=Identity_dev_Pass1
PATIENTS_DB_PASSWORD=Patients_dev_Pass1
DEVICES_DB_PASSWORD=Devices_dev_Pass1
VITALS_DB_PASSWORD=Vitals_dev_Pass1
ALERTS_DB_PASSWORD=Alerts_dev_Pass1
RISK_DB_PASSWORD=Risk_dev_Pass1
INSIGHTS_DB_PASSWORD=Insights_dev_Pass1

# HMAC key shared by identity (signs) and every API (validates); at least 32 characters
JWT_SIGNING_KEY=local-dev-signing-key-not-for-production-0123456789

# Demo logins created by the Development seeder (doctor@, nurse@, coordinator@, admin@remotehealthwatch.local)
SEED_DEMO_PASSWORD=Demo@12345
SEED_PATIENTS=60

# Device simulator: devices per replica and how many replicas
SIM_DEVICES=60
SIM_REPLICAS=1
SIM_INTERVAL_SECONDS=5
SIM_DETERIORATION_MINUTES=30

# Competing consumers demo: run several vitals replicas in one consumer group
VITALS_REPLICAS=1

# Hours a newly paired patient spends in baseline before monitoring is "active"
BASELINE_HOURS=24


# macOS AirPlay Receiver listens on 5000; pick another host port for the gateway if it clashes
GATEWAY_PORT=5000
