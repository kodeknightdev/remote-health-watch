{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IdentityDb": ""
  },
  "Jwt": {
    "Issuer": "remote-health-watch-identity",
    "Audience": "remote-health-watch",
    "SigningKey": "",
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 7
  }
}
