{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Warning",
        "Microsoft.AspNetCore.SignalR": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": ""
  },
  "Jwt": {
    "Issuer": "remote-health-watch-identity",
    "Audience": "remote-health-watch",
    "SigningKey": ""
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  "Services": {
    "PatientsGrpc": "http://localhost:5112"
  },
  "Cors": {
    "Origins": [
      "http://localhost:4200"
    ]
  }
}
